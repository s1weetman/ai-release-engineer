# Local application configuration.
# Copy this file to .env for local-only values. Never commit .env.

ARE_ENVIRONMENT=development
ARE_LOG_LEVEL=INFO
ARE_COMMAND_TIMEOUT_SECONDS=120
ARE_MAX_TOOL_OUTPUT_CHARS=50000
ARE_OPENAI_MODEL=gpt-6-luna

# Local MVP provider credential. Keep the real value only in your local .env
# or another secret store. Never commit a real key.
# OPENAI_API_KEY=

# The future multi-tenant SaaS BYOK implementation will store customer provider
# credentials in an encrypted backend secrets service rather than in .env files.
