# Local application configuration.
# Copy this file to .env for local-only values. Never commit .env.

ARE_ENVIRONMENT=development
ARE_LOG_LEVEL=INFO
ARE_COMMAND_TIMEOUT_SECONDS=120
ARE_MAX_TOOL_OUTPUT_CHARS=50000

# Future provider credentials will be documented here by variable name only.
# Real values must remain outside source control.
# Provider secrets used by the local MVP will be added only when the provider
# integration is implemented. Multi-tenant SaaS BYOK secrets will not be stored
# in this file.
